# Receipts environment template. PLACEHOLDERS ONLY -- never put a real
# key, token, or password in this file or in any commit.
#
# SAMPLE_MODE=true runs the whole pipeline on cached fixture data with
# zero credentials. This is the default, and it is how a keyless judge
# experiences the app.
SAMPLE_MODE=true

# Nightshift Meterless Runtime (from the Nightshift Console).
# The Runtime token below is a placeholder. The NVIDIA API key itself
# lives ONLY inside Nightshift (Providers tab) and NEVER appears here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your_nightshift_runtime_token_here
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris REST API (port 8888 is REST; port 3000 is the web UI only).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your_zetaris_api_token_here
ZETARIS_USERNAME=your_zetaris_username_here
ZETARIS_PASSWORD=your_zetaris_password_here
